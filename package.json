{
  "name": "busy-magpie",
  "productName": "Busy Magpie",
  "version": "1.4.2",
  "description": "magpie 实时路由桌面挂件 · A transparent live routing perch for your desktop.",
  "main": "shell/bootstrap.cjs",
  "exports": {
    "./server": "./plugin/server.mjs",
    ".": "./shell/bootstrap.cjs"
  },
  "author": "Busy Magpie",
  "license": "MIT",
  "private": true,
  "keywords": [
    "magpie",
    "magpie-plugin",
    "electron",
    "desktop"
  ],
  "engines": {
    "node": ">=20"
  },
  "magpie": {
    "hooks": "./plugin/launch.hooks.mjs",
    "icon": "https://raw.githubusercontent.com/yimi1mi/busy-magpie/main/assets/icon.png"
  },
  "scripts": {
    "test": "node tools/run-tests.cjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:business": "node tools/build-payload.cjs",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-win.ps1",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "^39.8.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.busymagpie.widget",
    "productName": "Busy Magpie",
    "artifactName": "Busy.Magpie-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "yimi1mi",
        "repo": "busy-magpie"
      }
    ],
    "asar": false,
    "files": [
      "shell/**/*",
      "src/**/*",
      "web/**/*",
      "plugin/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/busy-magpie.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Busy Magpie"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "minimumSystemVersion": "12.0",
      "icon": "assets/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "Busy Magpie",
      "backgroundColor": "#111117",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "3.3.3"
  }
}
